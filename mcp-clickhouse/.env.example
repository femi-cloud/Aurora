CLICKHOUSE_HOST=jloewipv3e.europe-west2.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<le password Cloud, celui déjà utilisé dans backend/ et ml-service/>
CLICKHOUSE_DATABASE=aurora
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true

# Transport réseau — nécessaire pour qu'un service Node externe s'y connecte
# (le mode par défaut "stdio" ne marche que pour des clients locaux type Claude Desktop)
CLICKHOUSE_MCP_SERVER_TRANSPORT=http
CLICKHOUSE_MCP_BIND_HOST=127.0.0.1
CLICKHOUSE_MCP_BIND_PORT=8000

# Pour un test local uniquement — jamais en prod/déployé
CLICKHOUSE_MCP_AUTH_DISABLED=true